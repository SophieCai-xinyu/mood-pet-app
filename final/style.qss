#InputWindow {
    border-radius: 18px;
    background-color: rgba(20, 22, 28, 0.88);
}

#InputWindow QLineEdit,
#InputWindow QTextEdit {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    color: #f0f0f0;
    padding: 10px;
}

#InputWindow QLineEdit {
    font-size: 16px;
}

#InputWindow QTextEdit {
    font-size: 14px;
}

#InputWindow QPushButton {
    min-width: 100px;
    color: #ffffff;
    border-radius: 12px;
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(84, 114, 225, 200), stop:1 rgba(113, 97, 239, 200));
    padding: 10px 14px;
}

#InputWindow QPushButton:hover {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 rgba(103, 133, 242, 220), stop:1 rgba(132, 117, 247, 220));
}

#InputWindow QLabel {
    color: #d0d4e0;
    font-size: 14px;
}
